; Скопируйте этот файл в platformio_local.ini (он в .gitignore и не попадёт в git).
; Нужен на Windows, если путь к проекту содержит не-ASCII символы (кириллицу и т.п.) -
; иначе сборка может падать с ошибками линковки (например "ld.exe: cannot open map file").
;
; Если путь к проекту и так состоит только из латиницы/цифр - этот файл вам не нужен.

[platformio]
build_dir = C:/pio-build/feeder-for-students
